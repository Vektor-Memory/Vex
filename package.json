{
  "name": "@vektormemory/vex",
  "version": "0.7.0",
  "description": "Cross-standard vector DB migration tool — .vmig.jsonl interchange format for agent memory. Import Claude and ChatGPT conversations. Convert to OpenAI, Anthropic, Groq, Perplexity, Mistral formats.",
  "type": "module",
  "bin": {
    "vex": "./vex.mjs"
  },
  "main": "./vex.mjs",
  "exports": {
    ".": "./vex.mjs",
    "./adapters/langchain": "./adapters/langchain.js",
    "./adapters/convert": "./adapters/convert/index.js",
    "./core/sign": "./core/sign.js"
  },
  "files": [
    "vex.mjs",
    "formats/",
    "connectors/",
    "utils/",
    "core/",
    "adapters/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "keywords": [
    "vector",
    "database",
    "migration",
    "embeddings",
    "pinecone",
    "qdrant",
    "vektor",
    "agent-memory",
    "weaviate",
    "pgvector",
    "chroma",
    "cli",
    "vmig",
    "langchain",
    "memory-portability",
    "blake3",
    "ed25519",
    "claude",
    "chatgpt",
    "conversation-export",
    "llm-portability",
    "openai",
    "fine-tuning",
    "anthropic",
    "groq",
    "perplexity"
  ],
  "author": "Vektor Memory <hello@vektormemory.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/vektor-memory/vex",
  "repository": {
    "type": "git",
    "url": "https://github.com/vektor-memory/vex"
  },
  "bugs": {
    "url": "https://github.com/vektor-memory/vex/issues",
    "email": "hello@vektormemory.com"
  },
  "funding": {
    "type": "other",
    "url": "https://vektormemory.com/downloads"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "optionalDependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.2.0",
    "sqlite-vec": ">=0.1.0",
    "vektor-slipstream": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "sqlite-vec": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "vektor-slipstream": {
      "optional": true
    }
  }
}
